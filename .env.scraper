# Crawl limits
# Bumped to 400 to ensure we get through large paginated directories (e.g. A-Z lists)
MAX_PAGES=400
# Bumped to 5 to handle deep nesting (Home -> Partners -> Directory -> Search -> Results)
MAX_DEPTH=5

# Concurrency / politeness
# Slight bump to speed up the run, but kept under 20 to avoid 429 blocks
CONCURRENCY=16
# Reduced slightly for speed, but jitter keeps it "human-like"
BASE_DELAY_MS=1000
JITTER_MS=1000
REQUEST_TIMEOUT=15000

# Scoring / pruning
SCORE_THRESHOLD=5
PER_LABEL_KEEP=500
MAX_CANDIDATES_PER_LABEL=3000

# Global time limit per label (minutes)
TIME_LIMIT_MINUTES=45

# Output behavior
# KEEPER: Set this to 1 for the first run to wipe old "noisy" data.
# Set to 0 for future runs if you want to accumulate data.
CLEAR_OUTPUT=1